{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(.venv/bin/mkdocs build*)",
      "Bash(.venv/bin/mkdocs serve*)",
      "Bash(.venv/bin/pip list*)",
      "Bash(.venv/bin/pip freeze*)",
      "Bash(.venv/bin/pip show*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(ls*)",
      "Bash(find docs*)",
      "Bash(rg*)",
      "Bash(wc*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(rsync*)",
      "Bash(pm2*)",
      "Bash(./deploy/publish.sh --apply*)",
      "Bash(deploy/publish.sh --apply*)",
      "Bash(bash deploy/publish.sh --apply*)",
      "Bash(sh deploy/publish.sh --apply*)",
      "Bash(ssh vps-79tech-deploy*)",
      "Bash(scp*vps-79tech-deploy*)"
    ]
  }
}
